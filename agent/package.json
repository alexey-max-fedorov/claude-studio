{
  "name": "claude-studio",
  "version": "3.0.0",
  "description": "Claude Studio agent: localhost daemon that runs Claude Code in one project dir for the browser side panel",
  "type": "module",
  "bin": {
    "claude-studio": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "license": "Elastic-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "browser-extension",
    "side-panel",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@claude-studio/protocol": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
