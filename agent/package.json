{
  "name": "claude-studio",
  "version": "3.0.0",
  "description": "Claude Studio agent: localhost daemon that runs Claude Code in one project dir for the browser side panel",
  "type": "module",
  "bin": {
    "claude-studio": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "license": "Elastic-2.0",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "browser-extension",
    "side-panel",
    "agent"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepack": "pnpm --filter claude-studio... build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@anthropic-ai/sdk": "0.93.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "^8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@claude-studio/protocol": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexey-max-fedorov/claude-studio.git",
    "directory": "agent"
  },
  "homepage": "https://github.com/alexey-max-fedorov/claude-studio#readme",
  "bugs": {
    "url": "https://github.com/alexey-max-fedorov/claude-studio/issues"
  }
}
